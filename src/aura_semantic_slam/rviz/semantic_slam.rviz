Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: aura_slam_map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 90; 90; 100
      Alpha: 0.35
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Persistent object colours
      Enabled: true
      Topic:
        Value: /aura_semantic_slam/cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Alpha: 1
      Decay Time: 0
      Selectable: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Objects and near graph
      Enabled: true
      Topic:
        Value: /aura_semantic_slam/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Segmentation camera
      Enabled: true
      Topic:
        Value: /aura_semantic_slam/overlay
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.6
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1300
  Height: 900
