<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hv_bot">
  <link name="camera">
    <visual>
      <geometry><box size="0.025 0.045 0.025"/></geometry>
      <material name="camera_demo"><color rgba="0.08 0.08 0.10 1"/></material>
    </visual>
    <collision><geometry><box size="0.025 0.045 0.025"/></geometry></collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000003" iyy="0.000003" izz="0.000003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <!-- +pitch points the physical +X camera axis slightly downward. -->
    <origin xyz="0.12 0 0.45" rpy="0 0.12 0"/>
    <parent link="base_link"/><child link="camera"/>
  </joint>
  <link name="camera_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <!-- Preserve the current working raw-cloud convention for this test.
         The mapper explicitly uses camera's physical X-forward coordinates. -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera"/><child link="camera_optical"/>
  </joint>
  <link name="camera_demo_mast">
    <visual>
      <geometry><cylinder radius="0.006" length="0.41"/></geometry>
      <material name="mast_demo"><color rgba="0.22 0.23 0.25 1"/></material>
    </visual>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="0.000043" iyy="0.000043" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_demo_mast_joint" type="fixed">
    <origin xyz="0.12 0 0.24" rpy="0 0 0"/>
    <parent link="base_link"/><child link="camera_demo_mast"/>
  </joint>
  <gazebo reference="camera">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <update_rate>10.0</update_rate>
      <always_on>true</always_on>
      <topic>camera</topic>
      <gz_frame_id>camera_optical</gz_frame_id>
      <camera>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
        <optical_frame_id>camera_optical</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
</robot>
