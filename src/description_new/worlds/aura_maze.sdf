<?xml version="1.0"?>
<sdf version="1.9">
  <world name="aura_maze_world">
    <!-- Generated maze: 12 x 9 m, 1.5 m rooms, loops and dead ends.
         Robot: existing launch_sim.launch.py spawn (0, 0), yaw 3.14.
         The matching map uses these same wall rectangles, in world coordinates.
         Goal discs and floor tiles are visual-only; they do not block lidar.
         The existing robot URDF supplies its Sensors and Imu systems. -->
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.16 0.19 0.25 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 -0.4 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <pose>3 2 0 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>18 16</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>18 16</size></plane></geometry>
          <material><ambient>0.2 0.23 0.29 1</ambient><diffuse>0.2 0.23 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="floor_0_0">
